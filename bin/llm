#!/usr/bin/env -S python3 -I
"""`llm` is now `lllm` (1.3.0). This shim keeps old links and the old reload unit
working for one release: it hands over to `lllm`, whose first run moves them to
the new names. Remove in 1.4."""
import os
import sys
from pathlib import Path

new = Path(__file__).resolve().parent / "lllm"
os.execv(new, [str(new), *sys.argv[1:]])
