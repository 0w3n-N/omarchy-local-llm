#!/usr/bin/env -S python3 -I
"""llm sandbox — a Docker box where local models run shell commands, away from your system.

Any agent harness that lets you choose its shell (or honours $SHELL) can point
at `sandbox-bash`: it behaves like bash, but every command runs inside one
long-lived container that sees only the sandbox folder (~/Sandbox by default,
mounted at the same path) and none of your home, keys or environment.

You never need to touch docker: `llm sandbox setup` once, then
`llm sandbox shell`, `llm sandbox with <harness>`, or SHELL=sandbox-bash.

Part of https://github.com/0w3n-N/omarchy-local-llm (MIT).
"""
import grp
import json
import os
import pwd
import shlex
import shutil
import signal
import subprocess
import sys
import uuid
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "local-llm"
CONFIG = CONFIG_DIR / "sandbox.json"
NAME = "local-llm-sandbox"            # container name
IMAGE = "local-llm-sandbox:latest"
LABEL = "io.github.0w3n-n.local-llm.sandbox"
BIN = Path.home() / ".local/bin"
SELF = Path(__file__).resolve()
SHIM = "sandbox-bash"
INNER_HOME = "/home/sandbox"
RUN_DIR = "/tmp/.sandbox-run"         # pgid files, so a killed caller can kill its command
FORWARD_ENV = ("TERM", "COLORTERM", "COLUMNS", "LINES", "NO_COLOR", "FORCE_COLOR")  # not LANG: host locales don't exist inside

DEFAULTS = {
    "workspace": str(Path.home() / "Sandbox"),
    "network": True,        # internet access (pip/npm/git clone); false = fully offline
    "memory": "8g",
    "cpus": max(1, min(8, (os.cpu_count() or 2) // 2)),
    "pids": 1024,
    "packages": [],         # extra Debian packages baked into the image
    "env": [],              # extra host variable names forwarded into commands
}

DOCKERFILE = """\
FROM debian:trixie-slim
ARG UID=1000
ARG GID=1000
ARG EXTRA=""
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \\
      bash bash-completion ca-certificates coreutils procps util-linux less file tree \\
      git curl wget openssh-client jq ripgrep fd-find sqlite3 vim-tiny nano \\
      unzip zip xz-utils bzip2 patch diffutils findutils sed gawk make \\
      build-essential pkg-config python3 python3-pip python3-venv python3-dev \\
      nodejs npm $EXTRA \\
 && rm -rf /var/lib/apt/lists/* \\
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \\
 && (getent group $GID || groupadd -g $GID sandbox) \\
 && useradd -m -d /home/sandbox -u $UID -g $GID -s /bin/bash sandbox \\
 && printf '%s\\n' \\
      'export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"' \\
      'export PIP_BREAK_SYSTEM_PACKAGES=1 PIP_USER=1 npm_config_prefix="$HOME/.npm-global"' \\
      'PS1="\\[\\e[1;33m\\][sandbox]\\[\\e[0m\\] \\w \\$ "' >> /home/sandbox/.bashrc \\
 && cp /home/sandbox/.bashrc /home/sandbox/.profile
LABEL io.github.0w3n-n.local-llm.sandbox=1
USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
"""


# ── helpers ────────────────────────────────────────────────────────────────

def die(msg, code=1):
    print(f"sandbox: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg):
    print(msg, file=sys.stderr)


def load_config():
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(CONFIG.read_text()))
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        die(f"can't read {CONFIG}: {e}")
    cfg["workspace"] = str(Path(os.path.expanduser(cfg["workspace"])).resolve())
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    out = {k: v for k, v in cfg.items() if k in DEFAULTS}
    CONFIG.write_text(json.dumps(out, indent=2) + "\n")


_docker_ok = False


def docker_argv(*args):
    global _docker_ok
    if not _docker_ok:
        if not shutil.which("docker"):
            die("docker isn't installed — run: llm sandbox setup")
        r = subprocess.run(["docker", "version", "-f", "{{.Server.Version}}"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            if "permission denied" in r.stderr.lower() and in_docker_group_file():
                die("you were just added to the docker group — log out and back in once "
                    "(or run `llm sandbox setup` to use it right now)")
            if "permission denied" in r.stderr.lower():
                die("no permission to use docker — run: llm sandbox setup")
            die("the docker service isn't reachable — run: llm sandbox setup\n  " + r.stderr.strip())
        _docker_ok = True
    return ["docker", *args]


def session_has_docker_group():
    try:
        return grp.getgrnam("docker").gr_gid in os.getgroups()
    except KeyError:
        return False


def docker(*args, check=True, capture=False, quiet=False):
    kw = {}
    if capture:
        kw = {"capture_output": True, "text": True}
    elif quiet:
        kw = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    r = subprocess.run(docker_argv(*args), **kw)
    if check and r.returncode != 0:
        detail = (r.stderr or "").strip() if capture else ""
        die(f"docker {args[0]} failed{': ' + detail if detail else ''}", r.returncode)
    return r


def in_docker_group_file():
    try:
        return pwd.getpwuid(os.getuid()).pw_name in grp.getgrnam("docker").gr_mem
    except KeyError:
        return False


def state():
    """'running', 'exited', ... or None when the container doesn't exist."""
    r = docker("inspect", "-f", "{{.State.Status}}", NAME, check=False, capture=True)
    return r.stdout.strip() if r.returncode == 0 else None


def image_exists():
    return docker("image", "inspect", IMAGE, check=False, quiet=True).returncode == 0


def image_current(cfg):
    """True when the image was built with the saved extra-package list."""
    r = docker("image", "inspect", "-f", f'{{{{index .Config.Labels "{LABEL}.packages"}}}}',
               IMAGE, check=False, capture=True)
    return r.returncode == 0 and r.stdout.strip() == " ".join(cfg["packages"])


def build_image(cfg):
    say("Building the sandbox image (first time takes a few minutes)…")
    extra = " ".join(cfg["packages"])
    p = docker_argv("build", "-t", IMAGE,
                    "--build-arg", f"UID={os.getuid()}", "--build-arg", f"GID={os.getgid()}",
                    "--build-arg", f"EXTRA={extra}", "--label", f"{LABEL}.packages={extra}", "-")
    r = subprocess.run(p, input=DOCKERFILE, text=True, stdout=sys.stderr)  # keep a shim caller's stdout clean
    if r.returncode != 0:
        die("image build failed (see output above)", r.returncode)


def create_container(cfg):
    ws = Path(cfg["workspace"])
    ws.mkdir(parents=True, exist_ok=True)
    if ws == Path.home() or Path.home().is_relative_to(ws):
        die(f"workspace {ws} would expose your whole home — pick a subfolder (llm sandbox config workspace PATH)")
    args = [
        "run", "-d", "--name", NAME, "--hostname", "sandbox",
        "--label", f"{LABEL}=1", "--init",
        "--restart", "no",
        # Nothing of the host but the workspace, at the same absolute path so a
        # harness's cwd on the host is valid inside too.
        "-v", f"{ws}:{ws}",
        "-w", str(ws),
        # Commands run as an unprivileged user that can never regain privileges.
        # The few capabilities kept here are only usable by root, i.e. by
        # `llm sandbox install`, which you run — never by the model.
        "--cap-drop", "ALL",
        "--cap-add", "CHOWN", "--cap-add", "DAC_OVERRIDE", "--cap-add", "FOWNER",
        "--cap-add", "SETUID", "--cap-add", "SETGID", "--cap-add", "KILL",
        "--security-opt", "no-new-privileges",
        "--memory", str(cfg["memory"]), "--memory-swap", str(cfg["memory"]),
        "--cpus", str(cfg["cpus"]), "--pids-limit", str(cfg["pids"]),
        "--tmpfs", f"{RUN_DIR}:mode=1777,size=1m",
    ]
    if not cfg["network"]:
        args += ["--network", "none"]
    docker(*args, IMAGE, "sleep", "infinity", quiet=True)


def ensure_running(cfg=None):
    cfg = cfg or load_config()
    st = state()
    if st == "running":
        return cfg
    if st is None:
        if not image_current(cfg):
            build_image(cfg)
        create_container(cfg)
    else:
        docker("start", NAME, quiet=True)
    return cfg


def inner_cwd(cfg, cwd=None):
    ws = Path(cfg["workspace"])
    try:
        here = Path(cwd or os.getcwd()).resolve()
    except FileNotFoundError:
        return str(ws)
    return str(here) if here == ws or here.is_relative_to(ws) else str(ws)


def env_args(cfg):
    out = []
    for k in (*FORWARD_ENV, *cfg["env"]):
        if k in os.environ:
            out += ["-e", f"{k}={os.environ[k]}"]
    return out


def exec_in(cfg, argv, cwd=None, user=None, tty=None):
    """Run argv inside the container in its own session; forward signals so a
    harness that kills its 'bash' (timeouts, Ctrl-C) really kills the command."""
    tag = uuid.uuid4().hex
    pidfile = f"{RUN_DIR}/{tag}"
    if tty is None:
        tty = sys.stdin.isatty() and sys.stdout.isatty()
    # docker exec already makes the command a session/process-group leader;
    # record its pid so the whole group can be signalled later.
    wrapper = ["sh", "-c", f'echo $$ > {pidfile}; exec "$@"', "sh", *argv]
    flags = ["-i"] + (["-t"] if tty else [])
    if user:
        flags += ["-u", user]
    cmd = docker_argv("exec", *flags, "-w", inner_cwd(cfg, cwd),
                      "-e", f"HOME={INNER_HOME if user is None else '/root'}",
                      *env_args(cfg), NAME, *wrapper)

    proc = subprocess.Popen(cmd)

    def relay(signum, _frame):
        sig = {signal.SIGINT: "INT", signal.SIGHUP: "HUP"}.get(signum, "TERM")
        subprocess.run(docker_argv("exec", "-u", "0", NAME, "sh", "-c",
                                   f'[ -f {pidfile} ] && kill -{sig} -$(cat {pidfile})'),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if signum != signal.SIGINT or not tty:
            proc.terminate()

    for s in (signal.SIGTERM, signal.SIGHUP) + (() if tty else (signal.SIGINT,)):
        signal.signal(s, relay)
    if tty:
        signal.signal(signal.SIGINT, signal.SIG_IGN)  # the tty delivers ^C inside
    rc = proc.wait()
    subprocess.run(docker_argv("exec", "-u", "0", NAME, "rm", "-f", pidfile),
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return rc


# ── commands ───────────────────────────────────────────────────────────────

def cmd_setup(args):
    """Install/enable docker, grant this user access, build the image, start the box."""
    as_root = (["sudo"] if sys.stdin.isatty() else ["pkexec"])
    user = pwd.getpwuid(os.getuid()).pw_name

    if not shutil.which("docker"):
        say("Installing docker (needs your password)…")
        if subprocess.run([*as_root, "pacman", "-S", "--needed", "--noconfirm", "docker"]).returncode:
            die("couldn't install docker")
    if subprocess.run(["systemctl", "is-enabled", "-q", "docker.socket"]).returncode:
        say("Enabling the docker service (starts on demand)…")
        if subprocess.run([*as_root, "systemctl", "enable", "--now", "docker.socket"]).returncode:
            die("couldn't enable docker.socket")
    if not in_docker_group_file():
        say(f"Letting {user} use docker (adds you to the 'docker' group; needs your password)…")
        if subprocess.run([*as_root, "usermod", "-aG", "docker", user]).returncode:
            die("couldn't add you to the docker group")
    if not session_has_docker_group():
        # Group membership only reaches new logins. Bridge this session with an
        # ACL on the socket; it disappears when docker restarts (by then you've
        # logged in again and have the group for real).
        say("Granting this login session access until you next log in…")
        subprocess.run(["systemctl", "start", "docker.socket"], stderr=subprocess.DEVNULL)
        if subprocess.run([*as_root, "setfacl", "-m", f"u:{user}:rw", "/run/docker.sock"]).returncode:
            die("couldn't grant access — log out and back in, then run setup again")

    cfg = load_config()
    if not CONFIG.exists():
        save_config(cfg)
    for name in ("llm-sandbox", SHIM):
        link = BIN / name
        if link.is_symlink() and link.resolve() == SELF:
            continue
        ours = link.is_symlink() and Path(os.readlink(link)).name == "llm-sandbox"
        if (link.exists() or link.is_symlink()) and not ours:
            say(f"  kept {link} (something else is there)")
            continue
        BIN.mkdir(parents=True, exist_ok=True)
        if ours:
            link.unlink()
        link.symlink_to(SELF)
        say(f"  linked {link}")

    if "--rebuild" in args or not image_exists():
        build_image(cfg)
    if state() is not None and "--rebuild" in args:
        docker("rm", "-f", NAME, quiet=True)
    ensure_running(cfg)
    print(f"""
Sandbox ready. Only {cfg['workspace']} is shared with it.

  llm sandbox shell              open a shell inside (type `exit` to leave)
  llm sandbox with <harness>     start a harness whose bash runs in the sandbox
  SHELL={BIN / SHIM}             or set this as any harness's shell""")


def needs_setup():
    if not shutil.which("docker") or not (BIN / SHIM).exists():
        return True
    r = subprocess.run(["docker", "image", "inspect", IMAGE], capture_output=True)
    return r.returncode != 0


def cmd_shell(args):
    if needs_setup() and sys.stdin.isatty():
        say("The sandbox isn't set up yet — doing that first.\n")
        cmd_setup([])
        print()
    cfg = ensure_running()
    sys.exit(exec_in(cfg, ["bash", "-l", *args]))


def cmd_root(args):
    cfg = ensure_running()
    say("root shell — anything you install here is lost on `llm sandbox reset`; "
        "use `llm sandbox install` to keep packages.")
    sys.exit(exec_in(cfg, ["bash", *args], user="0"))


def cmd_run(args):
    if not args:
        die("usage: llm sandbox run <command…>")
    cfg = ensure_running()
    sys.exit(exec_in(cfg, ["bash", "-lc", shlex.join(args)] if len(args) > 1 else ["bash", "-lc", args[0]]))


def shim_main(argv):
    """`sandbox-bash …` == `bash …`, inside the sandbox. Any flags work (-c, -l, -i, scripts)."""
    cfg = ensure_running()
    sys.exit(exec_in(cfg, ["bash", *argv]))


def cmd_with(args):
    """Run a harness on the host with its shell swapped for sandbox-bash."""
    if not args:
        die("usage: llm sandbox with <harness> [args…]   e.g. llm sandbox with omp")
    cfg = ensure_running()
    shim = BIN / SHIM
    if not shim.exists():
        die("run `llm sandbox setup` first")
    exe = shutil.which(args[0])
    if not exe:
        die(f"'{args[0]}' isn't on your PATH")
    env = dict(os.environ, SHELL=str(shim), CLAUDE_CODE_SHELL=str(shim),
               LLM_SANDBOX_WORKSPACE=cfg["workspace"])
    here = Path.cwd().resolve()
    ws = Path(cfg["workspace"])
    if not (here == ws or here.is_relative_to(ws)):
        say(f"(starting in {ws} — commands can only see that folder)")
        os.chdir(ws)
    say("note: a harness's own read/write/edit tools still run on the host; only its shell is sandboxed.")
    os.execvpe(exe, args, env)


def cmd_status(args):
    cfg = load_config()
    st = state()
    print(f"container  {st or 'not created'}")
    print(f"workspace  {cfg['workspace']}")
    print(f"network    {'online' if cfg['network'] else 'offline'}")
    print(f"limits     {cfg['memory']} RAM, {cfg['cpus']} CPUs, {cfg['pids']} processes")
    if cfg["packages"]:
        print(f"packages   {' '.join(cfg['packages'])}")
    if st == "running":
        r = docker("exec", NAME, "ps", "-eo", "pid,etime,args", "--no-headers", check=False, capture=True)
        procs = [l for l in r.stdout.splitlines()
                 if not any(x in l for x in ("sleep infinity", "docker-init", "ps -eo"))]
        print(f"processes  {len(procs)}")
        for l in procs[:15]:
            print("   ", l.strip())


def cmd_stop(args):
    if state() == "running":
        docker("stop", "-t", "3", NAME, quiet=True)
    print("sandbox stopped (it starts again on next use)")


def cmd_reset(args):
    """Throw the container away (installed tools, ~ inside) — the workspace stays."""
    cfg = load_config()
    if "-y" not in args and sys.stdin.isatty():
        if input(f"Reset the sandbox? Everything outside {cfg['workspace']} inside it is lost. [y/N] ").strip().lower() not in ("y", "yes"):
            die("aborted")
    if state() is not None:
        docker("rm", "-f", NAME, quiet=True)
    if "--rebuild" in args:
        build_image(cfg)
    ensure_running(cfg)
    print("sandbox reset")


def cmd_install(args):
    if not args:
        die("usage: llm sandbox install <debian-package…>")
    cfg = ensure_running()
    rc = exec_in(cfg, ["sh", "-c", "apt-get update -qq && apt-get install -y --no-install-recommends \"$@\"",
                       "sh", *args], user="0")
    if rc:
        sys.exit(rc)
    cfg["packages"] = sorted(set(cfg["packages"]) | set(args))
    save_config(cfg)
    print("installed (and saved, so `reset --rebuild` keeps them)")


def cmd_config(args):
    cfg = load_config()
    if not args:
        print(json.dumps({k: cfg[k] for k in DEFAULTS}, indent=2))
        print(f"\nchange with: llm sandbox config <key> <value>   ({CONFIG})")
        return
    if len(args) != 2 or args[0] not in ("workspace", "network", "memory", "cpus", "pids", "env"):
        die("usage: llm sandbox config [workspace|network|memory|cpus|pids|env] <value>")
    key, val = args
    if key == "network":
        val = val.lower() in ("on", "true", "yes", "1", "online")
    elif key in ("cpus", "pids"):
        val = int(val) if key == "pids" else float(val)
    elif key == "env":
        val = [v for v in val.split(",") if v]
    cfg[key] = val
    save_config(cfg)
    if state() is not None:
        docker("rm", "-f", NAME, quiet=True)
        ensure_running(load_config())
        print(f"{key} set; sandbox recreated (workspace kept, tools installed by hand are gone)")
    else:
        print(f"{key} set")


def cmd_offline(args):
    cmd_config(["network", "off"])


def cmd_online(args):
    cmd_config(["network", "on"])


def cmd_open(args):
    subprocess.Popen(["xdg-open", load_config()["workspace"]],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_remove(args):
    """Delete the container and image. The workspace folder is kept."""
    if "-y" not in args and sys.stdin.isatty():
        if input("Remove the sandbox container and image? (workspace is kept) [y/N] ").strip().lower() not in ("y", "yes"):
            die("aborted")
    docker("rm", "-f", NAME, check=False, quiet=True)
    docker("image", "rm", IMAGE, check=False, quiet=True)
    for name in ("llm-sandbox", SHIM):
        link = BIN / name
        if link.is_symlink() and link.resolve() == SELF:
            link.unlink()
    print(f"removed. Your files in {load_config()['workspace']} are untouched.")


HELP = f"""\
llm sandbox — a Docker box where local models run commands, away from your system

  llm sandbox setup [--rebuild]   one-time: docker, permissions, image, start
  llm sandbox shell               shell inside the sandbox
  llm sandbox run <cmd…>          run one command inside
  llm sandbox with <harness…>     run a harness (omp, opencode, …) with its shell sandboxed
  {SHIM} [bash args]          drop-in bash: point a harness's shell setting at
                                  {BIN / SHIM}

  llm sandbox status              state, limits, what's running inside
  llm sandbox stop                stop it (auto-starts on next use)
  llm sandbox reset [--rebuild]   fresh container; workspace files are kept
  llm sandbox install <pkg…>      add Debian packages (kept across resets)
  llm sandbox root                root shell, for you — not for models
  llm sandbox offline | online    cut / restore its internet access
  llm sandbox config [key value]  workspace, memory, cpus, pids, env
  llm sandbox open                open the workspace folder
  llm sandbox remove [-y]         delete container + image (keeps workspace)

The sandbox sees only the workspace folder (default ~/Sandbox, same path
inside), runs as an unprivileged user with no host environment variables,
and is capped in RAM/CPU/processes. It's reachable from the internet side
like any program unless you go offline. Your harness's file tools still run
on the host; only shell commands are sandboxed.
"""

COMMANDS = {
    "setup": cmd_setup, "shell": cmd_shell, "sh": cmd_shell, "run": cmd_run, "exec": cmd_run,
    "with": cmd_with, "status": cmd_status, "stop": cmd_stop, "reset": cmd_reset,
    "install": cmd_install, "root": cmd_root, "config": cmd_config, "offline": cmd_offline,
    "online": cmd_online, "open": cmd_open, "remove": cmd_remove,
}


def main():
    if Path(sys.argv[0]).name == SHIM:
        shim_main(sys.argv[1:])
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(HELP)
        return
    cmd = COMMANDS.get(sys.argv[1])
    if not cmd:
        die(f"unknown command '{sys.argv[1]}' (llm sandbox --help)")
    try:
        cmd(sys.argv[2:])
    except KeyboardInterrupt:
        die("interrupted", 130)


if __name__ == "__main__":
    main()
