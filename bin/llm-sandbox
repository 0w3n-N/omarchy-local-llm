#!/usr/bin/env -S python3 -I
"""`llm-sandbox` is now `lllm-sandbox` (1.3.0). Harnesses whose shell is still the old
sandbox-bash link land here: move the links to the new names (via `lllm _migrate`),
then run the real thing. The name we were called as travels in LLLM_SANDBOX_ARGV0,
because a #! script only ever sees its own path in argv[0]. Remove in 1.4."""
import os
import subprocess
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
subprocess.run([str(here / "lllm"), "_migrate"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
os.environ["LLLM_SANDBOX_ARGV0"] = Path(sys.argv[0]).name
os.execv(here / "lllm-sandbox", [str(here / "lllm-sandbox"), *sys.argv[1:]])
