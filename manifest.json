{
  "schemaVersion": 1,
  "id": "io.github.0w3n-n.local-llm",
  "name": "Local LLM",
  "version": "1.1.1",
  "author": "0w3n-N",
  "license": "MIT",
  "description": "Run local LLMs with llama.cpp from the bar: see which model is in VRAM, load or unload models, pull GGUF models from Hugging Face, start or stop the server, and give models a Docker sandbox for their shell commands. The icon is a live attention-mask matrix with a VRAM gauge.",
  "homepage": "https://github.com/0w3n-N/omarchy-local-llm",
  "repository": "https://github.com/0w3n-N/omarchy-local-llm",
  "keywords": [
    "llm",
    "llama.cpp",
    "ai",
    "hugging face",
    "gguf",
    "local ai",
    "vram",
    "gpu",
    "openai api",
    "sandbox",
    "docker"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Local LLM",
    "description": "Load/unload llama.cpp models, start or stop the server, pull models, open the web UI.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 8080,
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "llama-server port",
        "min": 1,
        "max": 65535,
        "step": 1,
        "defaultValue": 8080
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval while closed (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
